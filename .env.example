# Sample environment file. Copy to `.env` (gitignored) and fill in real values.
# Real secrets must NEVER be committed.

# --- Postgres (docker-compose dev) ---
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_URL=jdbc:postgresql://localhost:5440/DBCUIDAR

# --- JWT (prod) ---
# Real IdP issuer, e.g. https://cuidar.us.auth0.com/  or  https://keycloak.cuidar.com/realms/cuidar
JWT_ISSUER_URI=https://your-idp.example.com/

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- SMTP (prod, used later by the email-verification sender) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="CuidAR <no-reply@cuidar.com>"
